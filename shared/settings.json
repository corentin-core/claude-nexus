{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": ["~/"],
    "allow": [
      "Read", "Glob", "Grep", "Edit", "Write", "NotebookEdit",
      "WebSearch", "WebFetch",
      "Bash"
    ],
    "deny": [
      "Bash(git push --force *)", "Bash(git push -f *)",
      "Bash(git push origin main *)", "Bash(git push origin master *)",
      "Bash(git add -A *)", "Bash(git add . *)", "Bash(git add .)",
      "Bash(rm -rf *)", "Bash(rm -r *)"
    ]
  }
}
